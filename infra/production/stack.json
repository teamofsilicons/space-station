{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Space Station: native Rust API, local PostgreSQL/Redis, separate native ClickHouse, private networking.",
  "Parameters": {
    "VpcId": {
      "Type": "String"
    },
    "SubnetId": {
      "Type": "String"
    },
    "CertificateArn": {
      "Type": "String"
    },
    "AmiId": {
      "Type": "String"
    }
  },
  "Resources": {
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "space-station-production-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "Backups",
              "Status": "Enabled",
              "Prefix": "backups/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiRuntime": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "space-station/production/ApiRuntime",
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ClickhouseRuntime": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "space-station/production/ClickhouseRuntime",
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
          "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
        ],
        "Policies": [
          {
            "PolicyName": "OwnRuntimeAndBackups",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Artifacts",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "ApiRuntime"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "ApiProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "ApiRole"
          }
        ]
      }
    },
    "ClickhouseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
          "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
        ],
        "Policies": [
          {
            "PolicyName": "OwnRuntimeAndBackups",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Artifacts",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "ClickhouseRuntime"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "ClickhouseProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "ClickhouseRole"
          }
        ]
      }
    },
    "GatewaySecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Space Station HTTPS gateway",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "space-station-production",
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": [
          "subnet-07945746462c26b2d",
          "subnet-0ba15539f08a1f48f"
        ],
        "SecurityGroups": [
          {
            "Ref": "GatewaySecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "120"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "GatewayHttps": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Gateway"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "GatewayTargetGroup"
            }
          }
        ]
      }
    },
    "GatewayHttp": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Gateway"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "GatewayFirewall": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "space-station-production",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "CloudWatchMetricsEnabled": true,
          "SampledRequestsEnabled": true,
          "MetricName": "SpaceStationGateway"
        },
        "Rules": [
          {
            "Name": "rate-limit",
            "Priority": 0,
            "Action": {
              "Block": {}
            },
            "Statement": {
              "RateBasedStatement": {
                "Limit": 100000,
                "AggregateKeyType": "IP"
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "SampledRequestsEnabled": true,
              "MetricName": "SpaceStationRateLimit"
            }
          },
          {
            "Name": "ip-reputation",
            "Priority": 1,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesAmazonIpReputationList"
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "SampledRequestsEnabled": true,
              "MetricName": "SpaceStationIpReputation"
            }
          },
          {
            "Name": "common",
            "Priority": 2,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet",
                "RuleActionOverrides": [
                  {
                    "Name": "SizeRestrictions_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "EC2MetaDataSSRF_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "GenericLFI_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "GenericRFI_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "CrossSiteScripting_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  }
                ]
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "SampledRequestsEnabled": true,
              "MetricName": "SpaceStationCommon"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "GatewayFirewallAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Ref": "Gateway"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "GatewayFirewall",
            "Arn"
          ]
        }
      }
    },
    "ApiSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Space Station API: only the production ALB may connect",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "GatewaySecurityGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "ClickhouseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "ClickHouse: only the Space Station API may connect",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8123,
            "ToPort": 8123,
            "SourceSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "ApiInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t4g.large",
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "ApiSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "ApiProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "Monitoring": true,
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 64,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Name",
            "Value": "space-station-production-api"
          },
          {
            "Key": "Backup",
            "Value": "space-station"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y curl ca-certificates unzip jq python3 python3-boto3 build-essential pkg-config libssl-dev\nsystemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service\ninstall -d -m 0700 /etc/space-station\ninstall -d -m 0755 /opt/space-station/releases /opt/space-station/bin\nfallocate -l 4G /swapfile\nchmod 600 /swapfile\nmkswap /swapfile\nswapon /swapfile\necho '/swapfile none swap sw 0 0' >> /etc/fstab\ncurl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip -o /tmp/awscli.zip\nunzip -q /tmp/awscli.zip -d /tmp\n/tmp/aws/install\nrm -rf /tmp/aws /tmp/awscli.zip\n"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiRecovery": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Recover Space Station instance on EC2 system impairment",
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed_System",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ApiInstance"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "AlarmActions": [
          {
            "Fn::Sub": "arn:aws:automate:${AWS::Region}:ec2:recover"
          }
        ]
      }
    },
    "ClickhouseInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t4g.large",
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "ClickhouseSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "ClickhouseProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "Monitoring": true,
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 128,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Name",
            "Value": "space-station-production-clickhouse"
          },
          {
            "Key": "Backup",
            "Value": "space-station"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y curl ca-certificates unzip jq python3 python3-boto3 build-essential pkg-config libssl-dev\nsystemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service\ninstall -d -m 0700 /etc/space-station\ninstall -d -m 0755 /opt/space-station/releases /opt/space-station/bin\nfallocate -l 4G /swapfile\nchmod 600 /swapfile\nmkswap /swapfile\nswapon /swapfile\necho '/swapfile none swap sw 0 0' >> /etc/fstab\ncurl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip -o /tmp/awscli.zip\nunzip -q /tmp/awscli.zip -d /tmp\n/tmp/aws/install\nrm -rf /tmp/aws /tmp/awscli.zip\n"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ClickhouseRecovery": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Recover Space Station instance on EC2 system impairment",
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed_System",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ClickhouseInstance"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "AlarmActions": [
          {
            "Fn::Sub": "arn:aws:automate:${AWS::Region}:ec2:recover"
          }
        ]
      }
    },
    "GatewayTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "space-station-native-api",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "instance",
        "Targets": [
          {
            "Id": {
              "Ref": "ApiInstance"
            },
            "Port": 8080
          }
        ],
        "HealthCheckPath": "/api/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "space-station"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "SnapshotRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "dlm.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
        ]
      }
    },
    "DailySnapshots": {
      "Type": "AWS::DLM::LifecyclePolicy",
      "Properties": {
        "Description": "Daily Space Station snapshots retained seven days",
        "State": "ENABLED",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "SnapshotRole",
            "Arn"
          ]
        },
        "PolicyDetails": {
          "PolicyType": "EBS_SNAPSHOT_MANAGEMENT",
          "ResourceTypes": [
            "INSTANCE"
          ],
          "TargetTags": [
            {
              "Key": "Backup",
              "Value": "space-station"
            }
          ],
          "Schedules": [
            {
              "Name": "Daily",
              "CreateRule": {
                "Interval": 24,
                "IntervalUnit": "HOURS",
                "Times": [
                  "03:30"
                ]
              },
              "RetainRule": {
                "Count": 7
              },
              "CopyTags": true
            }
          ]
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/space-station/production/api",
        "RetentionInDays": 30
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiMemoryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station api memory capacity",
        "Namespace": "SpaceStation",
        "MetricName": "mem_used_percent",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ApiInstance"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 90,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing"
      }
    },
    "ApiDiskAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station api disk capacity",
        "Namespace": "SpaceStation",
        "MetricName": "disk_used_percent",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ApiInstance"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing"
      }
    },
    "ApiBackupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station daily logical backup failed or missing",
        "Namespace": "SpaceStation",
        "MetricName": "BackupSuccess",
        "Dimensions": [
          {
            "Name": "Role",
            "Value": "api"
          }
        ],
        "Statistic": "Minimum",
        "Period": 86400,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching"
      }
    },
    "ClickhouseLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/space-station/production/clickhouse",
        "RetentionInDays": 30
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ClickhouseMemoryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station clickhouse memory capacity",
        "Namespace": "SpaceStation",
        "MetricName": "mem_used_percent",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ClickhouseInstance"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 90,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing"
      }
    },
    "ClickhouseDiskAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station clickhouse disk capacity",
        "Namespace": "SpaceStation",
        "MetricName": "disk_used_percent",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ClickhouseInstance"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing"
      }
    },
    "ClickhouseBackupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station daily logical backup failed or missing",
        "Namespace": "SpaceStation",
        "MetricName": "BackupSuccess",
        "Dimensions": [
          {
            "Name": "Role",
            "Value": "clickhouse"
          }
        ],
        "Statistic": "Minimum",
        "Period": 86400,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching"
      }
    },
    "ApiHealthAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Space Station API or dependency readiness is failing",
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "UnHealthyHostCount",
        "Dimensions": [
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [
                "GatewayTargetGroup",
                "TargetGroupFullName"
              ]
            }
          },
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "Gateway",
                "LoadBalancerFullName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 3,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "missing"
      }
    }
  },
  "Outputs": {
    "ApiInstanceId": {
      "Value": {
        "Ref": "ApiInstance"
      }
    },
    "ClickhouseInstanceId": {
      "Value": {
        "Ref": "ClickhouseInstance"
      }
    },
    "ClickhousePrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "ClickhouseInstance",
          "PrivateIp"
        ]
      }
    },
    "GatewayDns": {
      "Value": {
        "Fn::GetAtt": [
          "Gateway",
          "DNSName"
        ]
      }
    },
    "GatewayArn": {
      "Value": {
        "Ref": "Gateway"
      }
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      }
    },
    "ApiRuntimeArn": {
      "Value": {
        "Ref": "ApiRuntime"
      }
    },
    "ClickhouseRuntimeArn": {
      "Value": {
        "Ref": "ClickhouseRuntime"
      }
    },
    "TargetGroupArn": {
      "Value": {
        "Ref": "GatewayTargetGroup"
      }
    }
  }
}
