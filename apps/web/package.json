{
  "name": "space-station-web",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "dev": "node scripts-build.mjs && node --import ./disable-telemetry.mjs ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "node scripts-build.mjs && node --import ./disable-telemetry.mjs ./node_modules/next/dist/bin/next build",
    "start": "node --import ./disable-telemetry.mjs ./node_modules/next/dist/bin/next start --port 3000",
    "check": "tsc --noEmit",
    "check-all": "npm run check && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "lucide-react": "^1.55.0",
    "marked": "^18.0.11",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
